<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta escura. Mesmas chaves de Light.xaml. -->
    <SolidColorBrush x:Key="BgBrush" Color="#0F141B"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171D26"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1C2430"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A3341"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A4658"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E6EAF0"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8B97A8"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#5B9BFF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#7AAEFF"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#4A86E6"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#0A1628"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1B2A44"/>

    <SolidColorBrush x:Key="HoverBrush" Color="#202938"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#2B4573"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#14301F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2D0F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3B1A1D"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#252E3B"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#171D26"/>
</ResourceDictionary>
