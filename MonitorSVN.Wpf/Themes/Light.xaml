<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta clara. Dark.xaml define exatamente as mesmas chaves. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E3E8EF"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EAF1FF"/>

    <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#DBE7FF"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#0F172A"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#475569"/>
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#E2E8F0"/>

    <!-- Cantos/rodapes de controles nativos (ex.: canto entre as barras de rolagem do DataGrid) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
</ResourceDictionary>
